    "@sentry/node": "^6.19.7",
    "@sentry/tracing": "^7.26.0",
    "@supabase/supabase-js": "^1.33.3",
    "@tekab-dev-team/prisma-generator-crud": "^3.0.0",
    "apollo-server-express": "3.5.0",
