    "passport-jwt": "4.0.0",
    "reflect-metadata": "0.1.13",
    "rxjs": "^7",
    "shelljs": "^0.8.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "4.3.0",
    "ts-node": "10.9.1",
