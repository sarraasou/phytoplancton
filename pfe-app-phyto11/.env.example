# =====================================================================
# Fichier d'exemple pour le lancement LOCAL avec docker-compose.
# Utilisation : copier ce fichier en ".env" (dans le meme dossier que
# docker-compose.yml) :   copy .env.example .env
# Ne jamais mettre de vraies cles dans ce fichier (il est sur GitHub).
# =====================================================================

# --- Base de donnees ---
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres
CLIENT_POSTGRESQL_USER=user_postgres
CLIENT_POSTGRESQL_PASSWORD=user_postgres
POSTGRESQL_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@db:5432/postgres"

# --- JWT (valeurs de developpement local uniquement) ---
BCRYPT_SALT=10
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_SECRET_KEY=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRATION=2d
JWT_EXPIRY=14400

# Ces deux cles sont signees avec le JWT_SECRET ci-dessus (dev local).
# Si tu changes JWT_SECRET, il faut les regenerer.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzIyMDAyMDAsImlzcyI6InN1cGFiYXNlIiwicmVmIjoibWFwbm1pbWxteGl0bnpha3ptbnUiLCJleHAiOjIwODc3NzYyMDAsInJvbGUiOiJhbm9uIn0.CDBXHklRE2DMgfT2c_FPY-lkmrNyP9tzDcKVGg5X980
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzIyMDAyMDAsImlzcyI6InN1cGFiYXNlIiwicmVmIjoibWFwbm1pbWxteGl0bnpha3ptbnUiLCJleHAiOjIwODc3NzYyMDAsInJvbGUiOiJzZXJ2aWNlX3JvbGUifQ.gBOwWRMWys6NHjHqLMLqeLMaEX_x6BBSgcobiSeYSH8

# --- Application ---
APP_NAME=PhytoVision
SITE_URL=http://localhost:3001
API_URL=http://localhost:8015
KONG_URL=http://kong:8000
FO_PORT=3501
GITPOD_WORKSPACE_URL=host.docker.internal:3001

# --- Authentification ---
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Connexions sociales desactivees en local (pas de cles necessaires)
ENABLE_GOOGLE_SIGNUP=false
GOOGLE_APP_CLIENT_ID=
GOOGLE_APP_CLIENT_SECRET=
ENABLE_FACEBOOK_SIGNUP=false
FACEBOOK_APP_CLIENT_ID=
FACEBOOK_APP_CLIENT_SECRET=
ENABLE_LINKEDIN_SIGNUP=false
LINKEDIN_APP_CLIENT_ID=
LINKEDIN_APP_CLIENT_SECRET=
ENABLE_GITHUB_SIGNUP=false
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Email (optionnel : laisser vide en local, l'inscription est auto-confirmee) ---
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=PhytoVision
SENDINBLEU_API_KEY=
BREVO_KEY=

# --- Services externes (optionnels, non necessaires en local) ---
LOKI_URL=
PRISMA_ACCELERATE_URL=
CF_ACCOUNT_ID=
CF_API_TOKEN=
SENTRY_DSN=
